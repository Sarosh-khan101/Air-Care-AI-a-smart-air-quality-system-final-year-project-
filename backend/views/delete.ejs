<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete account</title>
    <link rel="stylesheet" href="/css/delete.css"/>
</head>
<body>
        <div class="container">
         <h1>
            Air-Care-AI : <span>[<u>Smart Air Quality & Health Advisory System</u>]</span>
        </h1>
